# Nokopē šo failu kā .env un aizpildi vērtības.
# .env nekad netiek augšupielādēts GitHub.

# PostgreSQL datubāze (docker-compose to palaiž ar šiem datiem)
DATABASE_URL=postgres://vienavieta:vienavieta@localhost:5432/vienavieta

# Portāla adrese
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Slepenā atslēga sesijām. Izveido ar: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-pasta sūtīšana (Brevo, Postmark vai cits SMTP).
# Ja SMTP_HOST ir tukšs, izstrādē pieteikšanās saite tiek izdrukāta servera konsolē.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VienāVietā <noreply@vienavieta.lv>"

# Pieteikšanās ar sociālajiem tīkliem (pēc izvēles, sk. docs/AUTH-SETUP.md).
# Ja atstāj tukšu, attiecīgā poga netiek rādīta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Bilžu krātuve. Ja S3_BUCKET ir tukšs, bildes glabājas mapē data/uploads (izstrādei).
# Produkcijai ieteicams Cloudflare R2 (S3 saderīgs, bez maksas par lejupielādi).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Publiskā adrese bildēm (R2 publiskais domēns). Ja tukšs, bildes izsniedz pats portāls caur /media
MEDIA_PUBLIC_URL=
