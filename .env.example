# Nokopē šo failu kā .env un aizpildi vērtības.
# .env nekad netiek augšupielādēts GitHub.

# PostgreSQL datubāze (docker-compose to palaiž ar šiem datiem)
DATABASE_URL=postgres://vienavieta:vienavieta@localhost:5432/vienavieta

# Portāla adrese
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000

# Slepenā atslēga sesijām. Izveido ar: openssl rand -base64 32
BETTER_AUTH_SECRET=

# E-pasta sūtīšana. Ja ir BREVO_API_KEY, sūta caur Brevo API (HTTPS); citādi caur SMTP.
# Ja abi tukši, izstrādē pieteikšanās saite tiek izdrukāta servera konsolē.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="VienāVietā <noreply@vienavieta.lv>"

# Pieteikšanās ar sociālajiem tīkliem (pēc izvēles, sk. docs/AUTH-SETUP.md).
# Ja atstāj tukšu, attiecīgā poga netiek rādīta.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Bilžu krātuve: STORAGE_DRIVER = s3 | db | local.
# Noklusējums: s3, ja iestatīts S3_BUCKET, citādi local (mape data/uploads). "db" glabā bildes PostgreSQL (testa versijām).
STORAGE_DRIVER=
# Produkcijai ieteicams Cloudflare R2 (S3 saderīgs, bez maksas par lejupielādi).
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Publiskā adrese bildēm (R2 publiskais domēns). Ja tukšs, bildes izsniedz pats portāls caur /media
MEDIA_PUBLIC_URL=

# Karte (sk. docs/MAPS.md). Ja tukšs, izstrādē izmanto OpenStreetMap (nav paredzēts produkcijas slodzei).
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_TILES_ATTRIBUTION=
# Satelīta slānis. Ja iestatīts, kartē parādās pārslēgs "Karte / Satelīts".
NEXT_PUBLIC_MAP_SATELLITE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=

# Google karte (Map Tiles API). Ja tukšs, tiek rādīta OpenStreetMap. Sk. docs/MAPS.md
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Administratori (e-pasti ar komatu): piekļuve moderācijas panelim /moderacija
ADMIN_EMAILS=

# ss.com sarakstu ievākšana fonā: produkcijā ieslēgta pēc noklusējuma; "off" izslēdz, "on" ieslēdz izstrādē
SS_CRAWL=

# autoplius.lt vieglajiem auto ievākšana ar reālu pārlūku (Playwright): "off" izslēdz, "on" ieslēdz izstrādē
# (vajag chromium: npx playwright install chromium)
AUTOPLIUS_CRAWL=

# Īpašumu adrešu ģeokodēšana (Google Geocoding API). Servera atslēga, ierobežota tikai uz Geocoding API.
GOOGLE_GEOCODING_KEY=
# Push paziņojumi (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@vienavieta.lv
